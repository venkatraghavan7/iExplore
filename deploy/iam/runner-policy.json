{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeClaudeViaAuInferenceProfile",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": [
        "arn:aws:bedrock:ap-southeast-2:<ACCOUNT_ID>:inference-profile/au.anthropic.claude-*",
        "arn:aws:bedrock:ap-southeast-*::foundation-model/anthropic.claude-*"
      ]
    },
    {
      "Sid": "ListState",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<BUCKET>",
      "Condition": { "StringLike": { "s3:prefix": ["iexplore/*"] } }
    },
    {
      "Sid": "ReadWriteState",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::<BUCKET>/iexplore/*"
    }
  ]
}
