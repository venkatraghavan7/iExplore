{
  "name": "iexplore",
  "version": "0.2.0",
  "description": "iExplore: always-on exploratory testing with Claude computer use, dynamic personas and a learning loop",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "iexplore": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "iexplore": "tsx src/cli.ts",
    "mock": "tsx mock_site/server.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "1.1.1",
    "@anthropic-ai/sdk": "1.6.0",
    "axe-core": "4.14.0",
    "playwright": "1.64.1",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}